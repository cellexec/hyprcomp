# ── Application ─────────────────────────────────────────────────────────────


class OverviewApp(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="com.hyprcomp.overview",
                         flags=Gio.ApplicationFlags.NON_UNIQUE)
        self.screenshot_texture = None
        self.creating_project = False
        self.hovered_ws = None
        self.hovered_row = None
        self._sel_row = None
        self._sel_col = None
        self._cells = {}
        self._row_labels = {}
        self._row_max = {}
        self._visible = False

    def do_activate(self):
        # Create window once — reused across show/hide cycles
        self.win = Gtk.ApplicationWindow(application=self)
        Gtk4LayerShell.init_for_window(self.win)
        Gtk4LayerShell.set_layer(self.win, Gtk4LayerShell.Layer.OVERLAY)
        for edge in (
            Gtk4LayerShell.Edge.TOP,
            Gtk4LayerShell.Edge.BOTTOM,
            Gtk4LayerShell.Edge.LEFT,
            Gtk4LayerShell.Edge.RIGHT,
        ):
            Gtk4LayerShell.set_anchor(self.win, edge, True)
        Gtk4LayerShell.set_keyboard_mode(
            self.win, Gtk4LayerShell.KeyboardMode.EXCLUSIVE
        )
        Gtk4LayerShell.set_namespace(self.win, "hyprcomp-overview")

        css = Gtk.CssProvider()
        css.load_from_string(CSS)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        key_ctrl = Gtk.EventControllerKey()
        key_ctrl.connect("key-pressed", self._on_key)
        self.win.add_controller(key_ctrl)

        # Register SIGUSR1 for toggle from hyprcomp script
        GLib.unix_signal_add(GLib.PRIORITY_HIGH, signal.SIGUSR1, self._on_toggle)

        # Show and load data
        self._show()

    def _on_toggle(self):
        if self._visible:
            self._hide()
        else:
            self._show()
        return True  # keep handler registered

    def _show(self):
        self._visible = True
        self.screenshot_texture = None
        self.win.set_visible(True)
        self.win.present()
        # IPC queries are ~5ms each — fast enough to run on main thread
        grid_data = load_grid_data()
        self.projects, self.active_ws_id, self.ws_clients, self.ws_mon, self.primary_mon = (
            grid_data
        )
        self.active_row = ws_to_row(self.active_ws_id)
        self.active_col = ws_to_col(self.active_ws_id)
        self._build_grid()
        self._sel_row = self.active_row
        self._sel_col = self.active_col
        self._update_selection()
        self._start_ws_listener()
        # Capture fresh screenshot of active ws in background
        threading.Thread(target=self._capture_active_thumb, daemon=True).start()

    def _capture_active_thumb(self):
        try:
            active_ws = hyprctl_json("activeworkspace")
            path = capture_screenshot(active_ws.get("monitor", ""))
            if path and self._visible:
                GLib.idle_add(self._update_active_thumb, path)
        except Exception:
            pass

    def _update_active_thumb(self, path):
        if not self._visible:
            return False
        try:
            self.screenshot_texture = Gdk.Texture.new_from_filename(path)
        except Exception:
            return False
        # Update just the active cell's content
        btn = self._cells.get(self.active_ws_id)
        if btn:
            pic = Gtk.Picture.new_for_paintable(self.screenshot_texture)
            pic.set_size_request(CELL_W, CELL_H)
            pic.set_content_fit(Gtk.ContentFit.COVER)
            btn.set_child(pic)
        return False

    def _hide(self):
        self._visible = False
        self.win.set_visible(False)

    # ── Hyprland IPC listener ────────────────────────────────────────────────

    def _start_ws_listener(self):
        """Listen for workspace change events from Hyprland's socket2."""
        t = threading.Thread(target=self._ws_listener, daemon=True)
        t.start()

    def _ws_listener(self):
        sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
        runtime = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
        sock_path = f"{runtime}/hypr/{sig}/.socket2.sock"
        try:
            sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            sock.connect(sock_path)
            buf = b""
            while True:
                data = sock.recv(4096)
                if not data:
                    break
                buf += data
                while b"\n" in buf:
                    line, buf = buf.split(b"\n", 1)
                    line = line.decode("utf-8", errors="replace")
                    if line.startswith("workspace>>"):
                        try:
                            ws_id = int(line.split(">>", 1)[1])
                            GLib.idle_add(self._on_workspace_changed, ws_id)
                        except ValueError:
                            pass
        except Exception:
            pass

    def _on_workspace_changed(self, ws_id):
        """Update active highlight when workspace changes via gesture."""
        if ws_id == self.active_ws_id:
            return False

        old_ws = self.active_ws_id
        old_row = self.active_row
        old_col = self.active_col

        self.active_ws_id = ws_id
        self.active_row = ws_to_row(ws_id)
        self.active_col = ws_to_col(ws_id)

        # Toggle cell active border
        if old_ws in self._cells:
            self._cells[old_ws].remove_css_class("ws-cell-active")
        if ws_id in self._cells:
            self._cells[ws_id].add_css_class("ws-cell-active")

        # Toggle project label highlight
        if old_row != self.active_row:
            if old_row in self._row_labels:
                self._row_labels[old_row].remove_css_class("project-label-active")
            if self.active_row in self._row_labels:
                self._row_labels[self.active_row].add_css_class("project-label-active")

        return False

    # ── Grid building ───────────────────────────────────────────────────────

    def _build_grid(self):
        self._cells = {}
        self._row_labels = {}
        
        outer = Gtk.Box(
            orientation=Gtk.Orientation.VERTICAL,
            halign=Gtk.Align.CENTER,
            valign=Gtk.Align.CENTER,
        )
        outer.add_css_class("overview-box")

        # Per-row max column (highest occupied or active)
        row_max = {}
        for row in self.projects:
            m = 0
            for col in range(1, 11):
                if row_col_to_ws(row, col) in self.ws_clients:
                    m = col
            if row == self.active_row:
                m = max(m, self.active_col)
            row_max[row] = max(m, 1)

        self._row_max = row_max

        # Project rows
        for idx, row in enumerate(sorted(self.projects)):
            name = self.projects[row]
            is_active = row == self.active_row

            # Vertical group: title on top, cells below
            group = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            if idx > 0:
                group.set_margin_top(ROW_GAP * 2)

            # Title row: label + delete button
            title_box = Gtk.Box(
                orientation=Gtk.Orientation.HORIZONTAL,
                spacing=CELL_GAP,
            )
            del_btn = Gtk.Button(label="\u00d7")
            del_btn.add_css_class("del-btn")
            del_btn.set_valign(Gtk.Align.CENTER)
            del_btn.connect("clicked", self._on_delete_click, row, name, group)
            title_box.append(del_btn)

            display_name = name.rsplit("/", 1)[-1]
            label = Gtk.Label(label=display_name, xalign=0.0)
            label.set_hexpand(True)
            label.add_css_class("project-label")
            if is_active:
                label.add_css_class("project-label-active")
            self._row_labels[row] = label
            title_box.append(label)
            group.append(title_box)

            # Cells row
            row_box = Gtk.Box(
                orientation=Gtk.Orientation.HORIZONTAL,
                spacing=CELL_GAP,
                valign=Gtk.Align.CENTER,
            )
            row_box.set_margin_top(4)

            # Workspace cells — only up to this row's max occupied column
            for col in range(1, row_max[row] + 1):
                ws = row_col_to_ws(row, col)
                is_ws_active = ws == self.active_ws_id
                has_windows = ws in self.ws_clients

                btn = Gtk.Button()
                btn.add_css_class("ws-cell")
                if is_ws_active:
                    btn.add_css_class("ws-cell-active")
                btn.set_size_request(CELL_W, CELL_H)
                btn.set_overflow(Gtk.Overflow.HIDDEN)

                # Try screenshot: fresh for active ws, cached for others
                thumb = self._get_thumb(ws, is_ws_active)
                if thumb:
                    pic = Gtk.Picture.new_for_paintable(thumb)
                    pic.set_size_request(CELL_W, CELL_H)
                    pic.set_content_fit(Gtk.ContentFit.COVER)
                    btn.set_child(pic)
                elif has_windows:
                    da = Gtk.DrawingArea()
                    da.set_size_request(CELL_W, CELL_H)
                    mon = self.ws_mon.get(ws, self.primary_mon)
                    da.set_draw_func(make_synthetic_draw(self.ws_clients[ws], mon))
                    btn.set_child(da)
                else:
                    da = Gtk.DrawingArea()
                    da.set_size_request(CELL_W, CELL_H)
                    da.set_draw_func(draw_empty)
                    btn.set_child(da)

                btn.connect("clicked", self._on_cell_click, ws)
                self._cells[ws] = btn

                # Hover tracking for keyboard shortcuts
                motion = Gtk.EventControllerMotion()
                motion.connect("enter", self._on_cell_enter, ws, row)
                motion.connect("leave", self._on_cell_leave)
                btn.add_controller(motion)

                row_box.append(btn)

            group.append(row_box)
            outer.append(group)

        # "+ New Project" button
        self.new_btn = Gtk.Button(label="+ New Project")
        self.new_btn.add_css_class("new-btn")
        self.new_btn.set_halign(Gtk.Align.CENTER)
        self.new_btn.set_margin_top(20)
        self.new_btn.connect("clicked", self._on_new_project)
        outer.append(self.new_btn)

        self.win.set_child(outer)

    # ── Thumbnails ───────────────────────────────────────────────────────────

    def _get_thumb(self, ws_id, is_active):
        """Get screenshot texture: fresh capture for active ws, cached for others."""
        if is_active:
            return self.screenshot_texture
        path = os.path.join(CACHE_DIR, f"ws-{ws_id}.jpg")
        if os.path.isfile(path):
            try:
                return Gdk.Texture.new_from_filename(path)
            except Exception:
                pass
        return None

    # ── Hover tracking ──────────────────────────────────────────────────────

    def _on_cell_enter(self, _ctrl, _x, _y, ws, row):
        self.hovered_ws = ws
        self.hovered_row = row

    def _on_cell_leave(self, _ctrl):
        self.hovered_ws = None
        self.hovered_row = None

    # ── Keyboard selection ─────────────────────────────────────────────────

    def _update_selection(self):
        """Update CSS class on selected cell."""
        for ws, btn in self._cells.items():
            btn.remove_css_class("ws-cell-selected")
        if self._sel_row is not None and self._sel_col is not None:
            ws = row_col_to_ws(self._sel_row, self._sel_col)
            if ws in self._cells:
                self._cells[ws].add_css_class("ws-cell-selected")
            # Also update hovered state so d/a/x work with keyboard
            self.hovered_ws = ws
            self.hovered_row = self._sel_row

    def _move_selection(self, dr, dc):
        """Move keyboard selection by delta row/col."""
        if not self._row_max:
            return
        rows = sorted(self._row_max.keys())
        if self._sel_row is None:
            self._sel_row = rows[0]
            self._sel_col = 1
        else:
            idx = rows.index(self._sel_row) if self._sel_row in rows else 0
            idx = max(0, min(len(rows) - 1, idx + dr))
            self._sel_row = rows[idx]
            self._sel_col = max(1, min(self._row_max[self._sel_row], self._sel_col + dc))
        self._update_selection()

    # ── Event handlers ──────────────────────────────────────────────────────

    def _on_key(self, _ctrl, keyval, _keycode, _state):
        if self.creating_project:
            if keyval == Gdk.KEY_Escape:
                self._cancel_create()
                return True
            return False

        if keyval in (Gdk.KEY_Escape, Gdk.KEY_q):
            self._close_overlay()
            return True

        # Guard: data not loaded yet
        if not hasattr(self, "projects"):
            return False

        # Keyboard navigation
        if keyval in (Gdk.KEY_h, Gdk.KEY_Left):
            self._move_selection(0, -1)
            return True
        if keyval in (Gdk.KEY_l, Gdk.KEY_Right):
            self._move_selection(0, 1)
            return True
        if keyval in (Gdk.KEY_k, Gdk.KEY_Up):
            self._move_selection(-1, 0)
            return True
        if keyval in (Gdk.KEY_j, Gdk.KEY_Down):
            self._move_selection(1, 0)
            return True
        if keyval == Gdk.KEY_Return:
            if self._sel_row is not None and self._sel_col is not None:
                self._switch_to_ws(row_col_to_ws(self._sel_row, self._sel_col))
            return True

        # Number keys: select first window of Nth project
        if Gdk.KEY_1 <= keyval <= Gdk.KEY_9:
            rows = sorted(self._row_max.keys())
            idx = keyval - Gdk.KEY_1
            if idx < len(rows):
                self._sel_row = rows[idx]
                self._sel_col = 1
                self._update_selection()
            return True

        if keyval == Gdk.KEY_d and self.hovered_ws is not None:
            self._close_ws_windows(self.hovered_ws)
            return True

        if keyval == Gdk.KEY_a and self.hovered_row is not None:
            self._new_workspace_in_row(self.hovered_row)
            return True

        if keyval == Gdk.KEY_x and self.hovered_row is not None:
            self._delete_project_row(self.hovered_row)
            return True

        return False

    def _close_overlay(self):
        """Hide the overlay window instantly."""
        self._hide()

    def _switch_to_ws(self, ws_id):
        """Switch to workspace, update state, close overlay."""
        row = ws_to_row(ws_id)
        try:
            with open(STATE_FILE, "w") as f:
                f.write(f"current_row={row}\n")
        except Exception:
            pass
        subprocess.Popen(
            ["hyprctl", "dispatch", "workspace", str(ws_id)],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
        subprocess.Popen(
            ["pkill", "-SIGRTMIN+10", "waybar"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
        self._close_overlay()

    def _on_cell_click(self, _btn, ws_id):
        self._switch_to_ws(ws_id)

    def _close_ws_windows(self, ws_id):
        """Close all windows in a workspace and rebuild grid."""
        for client in self.ws_clients.get(ws_id, []):
            addr = client.get("address", "")
            if addr:
                subprocess.run(
                    ["hyprctl", "dispatch", "closewindow", f"address:{addr}"],
                    capture_output=True,
                )
        self._reload_grid()

    def _new_workspace_in_row(self, row):
        """Switch to first empty workspace after last occupied in row."""
        highest_col = 0
        for col in range(1, 11):
            if row_col_to_ws(row, col) in self.ws_clients:
                highest_col = col
        # Also consider the active workspace column in this row
        if row == self.active_row:
            highest_col = max(highest_col, self.active_col)
        target_col = min(highest_col + 1, 10)
        self._switch_to_ws(row_col_to_ws(row, target_col))

    def _reload_grid(self):
        """Reload data from hyprctl and rebuild the grid."""
        self.projects, self.active_ws_id, self.ws_clients, self.ws_mon, self.primary_mon = (
            load_grid_data()
        )
        self.active_row = ws_to_row(self.active_ws_id)
        self.active_col = ws_to_col(self.active_ws_id)
        self._build_grid()

    def _on_delete_click(self, btn, row, name, row_box):
        parent = btn.get_parent()
        parent.remove(btn)

        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        box.add_css_class("confirm-box")
        box.set_valign(Gtk.Align.CENTER)

        lbl = Gtk.Label(label=f"Delete {name}?")
        lbl.add_css_class("confirm-label")
        box.append(lbl)

        yes = Gtk.Button(label="Yes")
        yes.add_css_class("confirm-yes")
        yes.connect("clicked", self._do_delete, row)
        box.append(yes)

        no = Gtk.Button(label="No")
        no.add_css_class("confirm-no")
        no.connect("clicked", self._cancel_delete, box, row, name, row_box)
        box.append(no)

        parent.append(box)

    def _cancel_delete(self, _no_btn, confirm_box, row, name, row_box):
        parent = confirm_box.get_parent()
        parent.remove(confirm_box)
        del_btn = Gtk.Button(label="\u00d7")
        del_btn.add_css_class("del-btn")
        del_btn.set_valign(Gtk.Align.CENTER)
        del_btn.connect("clicked", self._on_delete_click, row, name, row_box)
        parent.append(del_btn)

    def _delete_project_row(self, row):
        """Close all windows in a project row, delete it, and reload."""
        for col in range(1, 11):
            ws = row_col_to_ws(row, col)
            for client in self.ws_clients.get(ws, []):
                addr = client.get("address", "")
                if addr:
                    subprocess.run(
                        ["hyprctl", "dispatch", "closewindow", f"address:{addr}"],
                        capture_output=True,
                    )
        subprocess.run([HYPRCOMP_BIN, "delete-row", str(row)], capture_output=True)
        self._reload_grid()

    def _do_delete(self, _btn, row):
        self._delete_project_row(row)

    def _on_new_project(self, _btn):
        if self.creating_project:
            return
        self.creating_project = True

        parent = self.new_btn.get_parent()
        parent.remove(self.new_btn)

        picker = self._build_folder_picker()
        self._picker = picker
        parent.append(picker)

    def _build_folder_picker(self):
        """Build the folder picker FlowBox with subproject support."""
        existing_names = set(self.projects.values())
        folders = []
        if os.path.isdir(PROJECTS_DIR):
            for name in sorted(os.listdir(PROJECTS_DIR)):
                path = os.path.join(PROJECTS_DIR, name)
                if os.path.isdir(path) and not name.startswith("."):
                    folders.append((name, path))

        picker = Gtk.FlowBox()
        picker.set_selection_mode(Gtk.SelectionMode.NONE)
        picker.set_max_children_per_line(6)
        picker.set_column_spacing(8)
        picker.set_row_spacing(8)
        picker.set_halign(Gtk.Align.CENTER)
        picker.add_css_class("folder-picker")
        picker.set_margin_top(12)

        for name, path in folders:
            subprojects = load_subprojects(path)
            if subprojects:
                # Check if all subprojects are already registered
                all_used = all(
                    f"{name}/{sp_rel}" in existing_names
                    for _, _, sp_rel in subprojects
                )
                btn = Gtk.Button(label=f"{name} \u203a")
                btn.add_css_class("folder-btn")
                if all_used:
                    btn.add_css_class("folder-btn-used")
                    btn.set_sensitive(False)
                else:
                    btn.connect(
                        "clicked", self._on_parent_folder_select,
                        name, path, picker,
                    )
            else:
                used = name in existing_names
                btn = Gtk.Button(label=name)
                btn.add_css_class("folder-btn")
                if used:
                    btn.add_css_class("folder-btn-used")
                    btn.set_sensitive(False)
                else:
                    btn.connect("clicked", self._on_folder_select, name, picker)
            picker.append(btn)

        if not folders:
            lbl = Gtk.Label(label="No folders found in ~/projects")
            lbl.add_css_class("confirm-label")
            picker.append(lbl)

        return picker

    def _on_parent_folder_select(self, _btn, parent_name, parent_path, old_picker):
        """Replace picker with subproject buttons + back button."""
        container = old_picker.get_parent()
        container.remove(old_picker)

        existing_names = set(self.projects.values())
        subprojects = load_subprojects(parent_path)

        picker = Gtk.FlowBox()
        picker.set_selection_mode(Gtk.SelectionMode.NONE)
        picker.set_max_children_per_line(6)
        picker.set_column_spacing(8)
        picker.set_row_spacing(8)
        picker.set_halign(Gtk.Align.CENTER)
        picker.add_css_class("folder-picker")
        picker.set_margin_top(12)

        # Back button
        back_btn = Gtk.Button(label="\u2039 Back")
        back_btn.add_css_class("folder-btn")
        back_btn.connect("clicked", self._on_subproject_back, picker)
        picker.append(back_btn)

        for display, abs_path, rel_path in subprojects:
            proj_name = f"{parent_name}/{rel_path}"
            nested = load_subprojects(abs_path)
            if nested:
                all_used = all(
                    f"{proj_name}/{sp_rel}" in existing_names
                    for _, _, sp_rel in nested
                )
                btn = Gtk.Button(label=f"{display} \u203a")
                btn.add_css_class("folder-btn")
                if all_used:
                    btn.add_css_class("folder-btn-used")
                    btn.set_sensitive(False)
                else:
                    btn.connect(
                        "clicked", self._on_parent_folder_select,
                        proj_name, abs_path, picker,
                    )
            else:
                used = proj_name in existing_names
                btn = Gtk.Button(label=display)
                btn.add_css_class("folder-btn")
                if used:
                    btn.add_css_class("folder-btn-used")
                    btn.set_sensitive(False)
                else:
                    btn.connect(
                        "clicked", self._on_folder_select,
                        proj_name, picker, abs_path,
                    )
            picker.append(btn)

        self._picker = picker
        container.append(picker)

    def _on_subproject_back(self, _btn, picker):
        """Return to main folder picker."""
        container = picker.get_parent()
        container.remove(picker)
        new_picker = self._build_folder_picker()
        self._picker = new_picker
        container.append(new_picker)

    def _cancel_create(self):
        if hasattr(self, "_picker") and self._picker:
            parent = self._picker.get_parent()
            parent.remove(self._picker)
            self._picker = None
            self.creating_project = False
            parent.append(self.new_btn)

    def _on_folder_select(self, _btn, name, picker, project_dir=None):
        # Create the project
        subprocess.run([HYPRCOMP_BIN, "create", name], capture_output=True)

        # Find the new row
        projects = load_projects()
        row = None
        for r, n in projects.items():
            if n == name:
                row = r
                break
        if row is None:
            self.creating_project = False
            self._reload_grid()
            return

        if project_dir is None:
            project_dir = os.path.join(PROJECTS_DIR, name)

        windows_config = load_project_config(project_dir)

        # Update state and switch to column 1
        try:
            with open(STATE_FILE, "w") as f:
                f.write(f"current_row={row}\n")
        except Exception:
            pass

        self.creating_project = False
        self._hide()

        # Launch apps in background (needs delays for windows to map)
        threading.Thread(
            target=self._launch_project_apps,
            args=(project_dir, row, name, windows_config),
            daemon=True,
        ).start()

    def _launch_project_apps(self, project_dir, row, name, windows_config):
        """Launch apps sequentially, waiting for each window to map."""
        import time

        for i, win in enumerate(windows_config[:10]):
            ws = row_col_to_ws(row, i + 1)
            hyprctl_dispatch(f"workspace {ws}")

            cmd = os.path.expanduser(win.get("exec", ""))
            if not cmd:
                continue

            cwd = project_dir
            if "cwd" in win:
                cwd = os.path.join(project_dir, win["cwd"])

            # Resolve url_env from project .env file
            url = ""
            if win.get("url_env"):
                env_file = os.path.join(cwd, ".env")
                try:
                    with open(env_file) as ef:
                        for line in ef:
                            line = line.strip()
                            if line.startswith(f"{win['url_env']}="):
                                url = line.split("=", 1)[1].strip().strip('"').strip("'")
                                break
                except FileNotFoundError:
                    pass

            before = sum(1 for c in hyprctl_json("clients") if c["workspace"]["id"] == ws)

            if win.get("terminal"):
                hyprctl_dispatch(
                    f"exec alacritty --working-directory {cwd} -e zsh -ic '{cmd}; exec zsh'"
                )
            elif win.get("browser"):
                data_dir = os.path.expanduser(f"~/.config/hyprcomp/chromium/{name}")
                os.makedirs(data_dir, exist_ok=True)
                url_arg = f" {url}" if url else ""
                hyprctl_dispatch(f"exec {cmd} --user-data-dir={data_dir}{url_arg}")
            else:
                hyprctl_dispatch(f"exec {cmd}")

            # Wait for the window to appear on this workspace
            deadline = time.time() + 15
            while time.time() < deadline:
                time.sleep(0.3)
                after = sum(1 for c in hyprctl_json("clients") if c["workspace"]["id"] == ws)
                if after > before:
                    break

        hyprctl_dispatch(f"workspace {row_col_to_ws(row, 1)}")
        subprocess.Popen(
            ["pkill", "-SIGRTMIN+10", "waybar"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )



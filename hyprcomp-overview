    def _confirm_close_all(self):
        """Close all projects and their windows."""
        # Collect all project workspaces, then close windows in one batch
        # to avoid hyprcomp reorder moving windows between deletions.
        target_workspaces = set()
        for row in self.projects:
            for col in range(1, 11):
                target_workspaces.add(row_col_to_ws(row, col))

        try:
            result = subprocess.run(
                ["hyprctl", "clients", "-j"], capture_output=True, text=True
            )
            live_clients = json.loads(result.stdout) if result.returncode == 0 else []
        except Exception:
            live_clients = []

        for client in live_clients:
            if client.get("workspace", {}).get("id") in target_workspaces:
                addr = client.get("address", "")
                if addr:
                    subprocess.run(
                        ["hyprctl", "dispatch", "closewindow", f"address:{addr}"],
                        capture_output=True,
                    )

        # Delete project entries in reverse order so reorder doesn't shift rows
        for row in sorted(self.projects.keys(), reverse=True):
            subprocess.run(
                [HYPRCOMP_BIN, "delete-row", str(row)], capture_output=True
            )

        self._confirm_row = None
        self._confirm_overlay = None
        self._reload_grid()

    def _delete_project_row(self, row, reload=True):
        """Close all windows in a project row, delete it, and reload."""
        if row == DESKTOP_ROW:
            return
        for col in range(1, 11):
            ws = row_col_to_ws(row, col)
            for client in self.ws_clients.get(ws, []):
                addr = client.get("address", "")
                if addr:
                    subprocess.run(
                        ["hyprctl", "dispatch", "closewindow", f"address:{addr}"],
                        capture_output=True,
                    )
        subprocess.run([HYPRCOMP_BIN, "delete-row", str(row)], capture_output=True)
        if reload:
            self._reload_grid()

    def _on_new_project(self, _btn=None):
        self._hide()
        menu_bin = os.path.join(os.path.dirname(os.path.abspath(__file__)), "hyprcomp-menu")
        subprocess.Popen([menu_bin], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


    def _launch_project_apps(self, project_dir, row, name, windows_config):
        """Launch apps sequentially, waiting for each window to map."""
        import time

        for i, win in enumerate(windows_config[:10]):
            ws = row_col_to_ws(row, i + 1)
            hyprctl_dispatch(f"workspace {ws}")

            cmd = os.path.expanduser(win.get("exec", ""))
            if not cmd:
                continue

            cwd = project_dir
            if "cwd" in win:
                cwd = os.path.join(project_dir, win["cwd"])

            # Resolve url_env from project .env file
            url = ""
            if win.get("url_env"):
                env_file = os.path.join(cwd, ".env")
                try:
                    with open(env_file) as ef:
                        for line in ef:
                            line = line.strip()
                            if line.startswith(f"{win['url_env']}="):
                                url = line.split("=", 1)[1].strip().strip('"').strip("'")
                                break
                except FileNotFoundError:
                    pass

            before = sum(1 for c in hyprctl_json("clients") if c["workspace"]["id"] == ws)

            if win.get("terminal"):
                hyprctl_dispatch(
                    f"exec alacritty --working-directory {cwd} -e zsh -ic '{cmd}; exec zsh'"
                )
            elif win.get("browser"):
                data_dir = os.path.expanduser(f"~/.config/hyprcomp/chromium/{name}")
                os.makedirs(data_dir, exist_ok=True)
                url_arg = f" {url}" if url else ""
                hyprctl_dispatch(f"exec {cmd} --user-data-dir={data_dir}{url_arg}")
            else:
                hyprctl_dispatch(f"exec {cmd}")

            # Wait for the window to appear on this workspace
            deadline = time.time() + 15
            while time.time() < deadline:
                time.sleep(0.3)
                after = sum(1 for c in hyprctl_json("clients") if c["workspace"]["id"] == ws)
                if after > before:
                    break

        hyprctl_dispatch(f"workspace {row_col_to_ws(row, 1)}")
        subprocess.Popen(
            ["pkill", "-SIGRTMIN+10", "waybar"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )



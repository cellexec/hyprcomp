# ── Config loading ─────────────────────────────────────────────────────────


def _load_toml(path):
    """Load a TOML file, return None on missing/invalid."""
    try:
        with open(path, "rb") as f:
            return tomllib.load(f)
    except (FileNotFoundError, tomllib.TOMLDecodeError):
        return None


def load_project_config(project_dir):
    """Resolve windows config: project .hyprcomp.toml → global defaults → built-in."""
    cfg = _load_toml(os.path.join(project_dir, ".hyprcomp.toml"))
    if cfg and "windows" in cfg:
        return cfg["windows"]
    cfg = _load_toml(DEFAULTS_FILE)
    if cfg and "windows" in cfg:
        return cfg["windows"]
    return BUILTIN_DEFAULTS["windows"]


def load_subprojects(project_dir):
    """Read [[subprojects]] from .hyprcomp.toml, return list of (display_name, abs_path, rel_path)."""
    cfg = _load_toml(os.path.join(project_dir, ".hyprcomp.toml"))
    if not cfg or "subprojects" not in cfg:
        return []
    result = []
    for sp in cfg["subprojects"]:
        rel = sp.get("path", "")
        if not rel:
            continue
        abs_path = os.path.join(project_dir, rel)
        if not os.path.isdir(abs_path):
            continue
        display = sp.get("name", os.path.basename(rel))
        result.append((display, abs_path, rel))
    return result


# ── Hyprland IPC ───────────────────────────────────────────────────────────

_HYPR_SOCK = None


def _get_sock_path():
    global _HYPR_SOCK
    if _HYPR_SOCK is None:
        sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
        runtime = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
        _HYPR_SOCK = f"{runtime}/hypr/{sig}/.socket.sock"
    return _HYPR_SOCK


def _hypr_request(msg):
    """Send a raw request to Hyprland's IPC socket."""
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.connect(_get_sock_path())
    sock.sendall(msg.encode())
    chunks = []
    while True:
        data = sock.recv(8192)
        if not data:
            break
        chunks.append(data)
    sock.close()
    return b"".join(chunks)


def hyprctl_json(cmd):
    """Query Hyprland via IPC socket (no subprocess)."""
    return json.loads(_hypr_request(f"j/{cmd}"))


def hyprctl_dispatch(args):
    """Dispatch a Hyprland command via IPC socket."""
    _hypr_request(f"dispatch {args}")


# ── Data layer ──────────────────────────────────────────────────────────────


def load_projects():
    projects = {}
    if os.path.isfile(PROJECTS_FILE):
        with open(PROJECTS_FILE) as f:
            for line in f:
                line = line.strip()
                if ":" in line:
                    row_s, name = line.split(":", 1)
                    projects[int(row_s)] = name
    return projects


def capture_screenshot(monitor_name):
    os.makedirs(CACHE_DIR, exist_ok=True)
    path = os.path.join(CACHE_DIR, "active.jpg")
    try:
        cmd = ["grim", "-t", "jpeg", "-q", "50", "-s", "0.25"]
        if monitor_name:
            cmd.extend(["-o", monitor_name])
        cmd.append(path)
        subprocess.run(cmd, capture_output=True, timeout=5)
        if os.path.isfile(path):
            return path
    except Exception:
        pass
    return None


def _parse_grid(active_ws, clients, monitors, workspaces):
    """Parse hyprctl data into grid model."""
    active_ws_id = active_ws["id"]

    ws_clients = {}
    for c in clients:
        ws_id = c["workspace"]["id"]
        if ws_id > 0:
            ws_clients.setdefault(ws_id, []).append(c)

    mon_info = {}
    for m in monitors:
        mon_info[m["name"]] = {
            "x": m["x"], "y": m["y"],
            "width": m["width"], "height": m["height"],
        }

    ws_mon = {}
    for ws in workspaces:
        mon_name = ws.get("monitor", "") or ws.get("lastmonitor", "")
        if mon_name in mon_info:
            ws_mon[ws["id"]] = mon_info[mon_name]

    primary_mon = None
    for m in monitors:
        if m.get("focused"):
            primary_mon = mon_info[m["name"]]
            break
    if primary_mon is None and monitors:
        primary_mon = mon_info[monitors[0]["name"]]

    return active_ws_id, ws_clients, ws_mon, primary_mon


def load_all():
    """Load grid data and screenshot. IPC queries are fast; grim runs in parallel."""
    # IPC socket queries — sequential is fine (~5ms each)
    active_ws = hyprctl_json("activeworkspace")
    clients = hyprctl_json("clients")
    monitors = hyprctl_json("monitors")
    workspaces = hyprctl_json("workspaces")
    projects = load_projects()

    active_ws_id, ws_clients, ws_mon, primary_mon = _parse_grid(
        active_ws, clients, monitors, workspaces
    )

    # grim is the slow part — run it last (still in background thread)
    screenshot_path = capture_screenshot(active_ws.get("monitor", ""))

    grid_data = (projects, active_ws_id, ws_clients, ws_mon, primary_mon)
    return grid_data, screenshot_path


def load_grid_data():
    """Reload just the grid data (no screenshot)."""
    active_ws = hyprctl_json("activeworkspace")
    clients = hyprctl_json("clients")
    monitors = hyprctl_json("monitors")
    workspaces = hyprctl_json("workspaces")
    projects = load_projects()

    active_ws_id, ws_clients, ws_mon, primary_mon = _parse_grid(
        active_ws, clients, monitors, workspaces
    )
    return projects, active_ws_id, ws_clients, ws_mon, primary_mon


# ── Workspace math ──────────────────────────────────────────────────────────


def ws_to_row(ws_id):
    return (ws_id - 1) // 10


def ws_to_col(ws_id):
    col = ws_id % 10
    return col if col != 0 else 10


def row_col_to_ws(row, col):
    return row * 10 + col


# ── Drawing ─────────────────────────────────────────────────────────────────


def make_synthetic_draw(windows, mon):
    """Return a draw func for a synthetic workspace preview."""

    def draw(da, cr, width, height, *_args):
        cr.set_source_rgb(*C["surface0"])
        cr.rectangle(0, 0, width, height)
        cr.fill()

        if not mon or not windows:
            return

        mon_w, mon_h = mon["width"], mon["height"]
        mon_x, mon_y = mon["x"], mon["y"]
        sx = width / mon_w
        sy = height / mon_h

        for i, w in enumerate(windows):
            wx, wy = w["at"]
            ww, wh = w["size"]
            wx -= mon_x
            wy -= mon_y
            rx, ry = wx * sx, wy * sy
            rw, rh = max(ww * sx, 4), max(wh * sy, 4)

            color = WIN_COLORS[i % len(WIN_COLORS)]
            cr.set_source_rgba(*color, 0.3)
            cr.rectangle(rx, ry, rw, rh)
            cr.fill()
            cr.set_source_rgba(*color, 0.8)
            cr.set_line_width(1.5)
            cr.rectangle(rx, ry, rw, rh)
            cr.stroke()

    return draw


def draw_empty(da, cr, width, height, *_args):
    """Dim dashed placeholder for empty workspace."""
    cr.set_source_rgb(*C["surface0"])
    cr.rectangle(0, 0, width, height)
    cr.fill()

    cr.set_source_rgba(*C["overlay0"], 0.4)
    cr.set_dash([6, 4])
    cr.set_line_width(1)
    m = 4
    cr.rectangle(m, m, width - 2 * m, height - 2 * m)
    cr.stroke()



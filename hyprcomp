#!/usr/bin/env bash
set -euo pipefail

CONFIG_DIR="$HOME/.config/hyprcomp"
STATE_FILE="$CONFIG_DIR/state"
PROJECTS_FILE="$CONFIG_DIR/projects"
DESKTOP_ROW=0
VERBOSE="${HYPRCOMP_VERBOSE:-0}"

mkdir -p "$CONFIG_DIR"

# --- Helpers ---

log() {
    [[ "$VERBOSE" == "1" ]] && echo "[hyprcomp] $*" >&2 || true
}

get_active_workspace() {
    hyprctl activeworkspace -j | jq -r '.id'
}

workspace_to_row() {
    echo $(( ($1 - 1) / 10 ))
}

workspace_to_col() {
    local col=$(( $1 % 10 ))
    [[ $col -eq 0 ]] && col=10
    echo "$col"
}

row_col_to_workspace() {
    echo $(( $1 * 10 + $2 ))
}

sync_state() {
    local ws
    ws=$(get_active_workspace)
    local row
    row=$(workspace_to_row "$ws")
    echo "current_row=$row" > "$STATE_FILE"
}

get_current_row() {
    if [[ -f "$STATE_FILE" ]]; then
        source "$STATE_FILE"
        echo "${current_row:-0}"
    else
        echo 0
    fi
}

get_max_row() {
    if [[ ! -f "$PROJECTS_FILE" ]] || [[ ! -s "$PROJECTS_FILE" ]]; then
        echo -1
        return
    fi
    awk -F: '{print $1}' "$PROJECTS_FILE" | sort -n | tail -1
}

get_project_name() {
    local row=$1
    if [[ -f "$PROJECTS_FILE" ]]; then
        grep "^${row}:" "$PROJECTS_FILE" 2>/dev/null | cut -d: -f2- || echo ""
    fi
}

row_exists() {
    local row=$1
    [[ -f "$PROJECTS_FILE" ]] && grep -q "^${row}:" "$PROJECTS_FILE"
}

next_free_row() {
    if [[ ! -f "$PROJECTS_FILE" ]] || [[ ! -s "$PROJECTS_FILE" ]]; then
        echo 1
        return
    fi
    # Reuse gaps from deleted rows
    local expected=1
    while IFS= read -r row; do
        if [[ $row -ne $expected ]]; then
            echo "$expected"
            return
        fi
        expected=$((expected + 1))
    done < <(awk -F: '{print $1}' "$PROJECTS_FILE" | sort -n)
    echo "$expected"
}

next_scratch_name() {
    local n=1
    while [[ -f "$PROJECTS_FILE" ]] && grep -q ":scratch-${n}$" "$PROJECTS_FILE"; do
        n=$((n + 1))
    done
    echo "scratch-${n}"
}

workspace_has_windows() {
    local ws=$1
    local count
    count=$(hyprctl clients -j | jq --argjson ws "$ws" '[.[] | select(.workspace.id == $ws)] | length')
    [[ "$count" -gt 0 ]]
}

get_highest_occupied_col() {
    local row=$1
    local start_ws=$((row * 10 + 1))
    local end_ws=$((row * 10 + 10))
    local highest
    highest=$(hyprctl clients -j | jq --argjson s "$start_ws" --argjson e "$end_ws" \
        '[.[] | select(.workspace.id >= $s and .workspace.id <= $e) | .workspace.id] | if length == 0 then 0 else max end')
    if [[ "$highest" -gt 0 ]]; then
        workspace_to_col "$highest"
    else
        echo 0
    fi
}

set_animation() {
    hyprctl keyword animation "workspaces, 1, 3, default, $1" > /dev/null
}

clean_row_thumbs() {
    local row=$1
    local dir="$HOME/.cache/hyprcomp/thumbs"
    for col in $(seq 1 10); do
        local ws=$((row * 10 + col))
        rm -f "$dir/ws-${ws}.jpg"
    done
}

capture_thumb() {
    # Capture a thumbnail of the current workspace before switching away
    local ws=$1
    local dir="$HOME/.cache/hyprcomp/thumbs"
    mkdir -p "$dir"
    grim -t jpeg -q 50 -s 0.25 "$dir/ws-${ws}.jpg" 2>/dev/null &
}

# --- Commands ---

cmd_up() {
    sync_state
    local ws row col target_row
    ws=$(get_active_workspace)
    row=$(workspace_to_row "$ws")
    col=$(workspace_to_col "$ws")

    # Already at Desktop row (top)
    if [[ $row -eq $DESKTOP_ROW ]]; then
        echo "Already at the top row"
        return 1
    fi

    # Find the nearest existing project row above
    target_row=$((row - 1))
    while [[ $target_row -ge 1 ]]; do
        if row_exists "$target_row"; then
            break
        fi
        target_row=$((target_row - 1))
    done

    # No project row above — go to Desktop row
    if [[ $target_row -lt 1 ]]; then
        target_row=$DESKTOP_ROW
    fi

    # Clamp column to highest occupied in target row
    local highest_col
    highest_col=$(get_highest_occupied_col "$target_row")
    if [[ $highest_col -gt 0 ]] && [[ $col -gt $highest_col ]]; then
        col=$highest_col
    fi

    local target_ws
    target_ws=$(row_col_to_workspace "$target_row" "$col")
    echo "current_row=$target_row" > "$STATE_FILE"
    capture_thumb "$ws"
    set_animation slidevert
    hyprctl dispatch workspace "$target_ws" > /dev/null
    pkill -SIGRTMIN+10 waybar 2>/dev/null || true
    local name
    if [[ $target_row -eq $DESKTOP_ROW ]]; then
        name="Desktop"
    else
        name=$(get_project_name "$target_row")
    fi
    log "up: row $row -> $target_row, ws $ws -> $target_ws"
    echo "Switched to row $target_row ($name) workspace $target_ws"
}

cmd_down() {
    sync_state
    local ws row col target_row max_row
    ws=$(get_active_workspace)
    row=$(workspace_to_row "$ws")
    col=$(workspace_to_col "$ws")
    max_row=$(get_max_row)

    if [[ $max_row -lt 0 ]]; then
        # No projects — open project launcher
        "$(dirname "$0")/hyprcomp-menu" &disown
        return 0
    fi

    if [[ $row -eq $DESKTOP_ROW ]]; then
        # From Desktop, go to first project row
        target_row=1
        while [[ $target_row -le $max_row ]]; do
            if row_exists "$target_row"; then
                break
            fi
            target_row=$((target_row + 1))
        done
        if [[ $target_row -gt $max_row ]]; then
            "$(dirname "$0")/hyprcomp-menu" &disown
            return 0
        fi
    else
        # Find the nearest existing row below
        target_row=$((row + 1))
        while [[ $target_row -le $max_row ]]; do
            if row_exists "$target_row"; then
                break
            fi
            target_row=$((target_row + 1))
        done

        if [[ $target_row -gt $max_row ]]; then
            # Past last project — open project launcher
            "$(dirname "$0")/hyprcomp-menu" &disown
            return 0
        fi
    fi

    # Clamp column to highest occupied in target row
    local highest_col
    highest_col=$(get_highest_occupied_col "$target_row")
    if [[ $highest_col -gt 0 ]] && [[ $col -gt $highest_col ]]; then
        col=$highest_col
    fi

    local target_ws
    target_ws=$(row_col_to_workspace "$target_row" "$col")
    echo "current_row=$target_row" > "$STATE_FILE"
    capture_thumb "$ws"
    set_animation slidevert
    hyprctl dispatch workspace "$target_ws" > /dev/null
    pkill -SIGRTMIN+10 waybar 2>/dev/null || true
    local name
    name=$(get_project_name "$target_row")
    log "down: row $row -> $target_row, ws $ws -> $target_ws"
    echo "Switched to row $target_row ($name) workspace $target_ws"
}

cmd_left() {
    sync_state
    local ws row col
    ws=$(get_active_workspace)
    row=$(workspace_to_row "$ws")
    col=$(workspace_to_col "$ws")

    if [[ $col -le 1 ]]; then
        return 0
    fi

    local target_ws
    target_ws=$(row_col_to_workspace "$row" $((col - 1)))
    capture_thumb "$ws"
    set_animation slide
    hyprctl dispatch workspace "$target_ws" > /dev/null
    pkill -SIGRTMIN+10 waybar 2>/dev/null || true
}

cmd_right() {
    sync_state
    local ws row col
    ws=$(get_active_workspace)
    row=$(workspace_to_row "$ws")
    col=$(workspace_to_col "$ws")

    if [[ $col -ge 10 ]]; then
        return 0
    fi

    local target_ws
    target_ws=$(row_col_to_workspace "$row" $((col + 1)))

    # Don't create a new empty workspace if the current one is empty
    if ! workspace_has_windows "$target_ws" && ! workspace_has_windows "$ws"; then
        return 0
    fi

    capture_thumb "$ws"
    set_animation slide
    hyprctl dispatch workspace "$target_ws" > /dev/null
    pkill -SIGRTMIN+10 waybar 2>/dev/null || true
}

cmd_go() {
    local col=${1:?Usage: hyprcomp go <column 1-10>}
    if [[ $col -lt 1 || $col -gt 10 ]]; then
        echo "Column must be 1-10"
        return 1
    fi

    sync_state
    local ws row target_ws
    ws=$(get_active_workspace)
    row=$(get_current_row)
    target_ws=$(row_col_to_workspace "$row" "$col")
    capture_thumb "$ws"
    set_animation slide
    hyprctl dispatch workspace "$target_ws" > /dev/null
    pkill -SIGRTMIN+10 waybar 2>/dev/null || true
}

cmd_move() {
    local col=${1:?Usage: hyprcomp move <column 1-10>}
    if [[ $col -lt 1 || $col -gt 10 ]]; then
        echo "Column must be 1-10"
        return 1
    fi

    sync_state
    local row
    row=$(get_current_row)
    local target_ws
    target_ws=$(row_col_to_workspace "$row" "$col")
    hyprctl dispatch movetoworkspace "$target_ws" > /dev/null
    pkill -SIGRTMIN+10 waybar 2>/dev/null || true
}

cmd_status() {
    sync_state
    local ws row col name
    ws=$(get_active_workspace)
    row=$(workspace_to_row "$ws")
    col=$(workspace_to_col "$ws")
    if [[ $row -eq $DESKTOP_ROW ]]; then
        name="Desktop"
    else
        name=$(get_project_name "$row")
    fi

    echo "Workspace: $ws"
    echo "Row: $row${name:+ ($name)}"
    echo "Column: $col"
}

cmd_list() {
    sync_state
    local current_row marker
    current_row=$(get_current_row)

    # Desktop row — always shown first
    marker=" "
    [[ $DESKTOP_ROW -eq $current_row ]] && marker="*"
    printf "%s Row %d: %s (workspaces %d-%d)\n" "$marker" "$DESKTOP_ROW" "Desktop" \
        "$(row_col_to_workspace "$DESKTOP_ROW" 1)" "$(row_col_to_workspace "$DESKTOP_ROW" 10)"

    if [[ ! -f "$PROJECTS_FILE" ]] || [[ ! -s "$PROJECTS_FILE" ]]; then
        echo "No projects registered. Use 'hyprcomp create <name>' to add one."
        return
    fi

    while IFS=: read -r row name; do
        marker=" "
        [[ $row -eq $current_row ]] && marker="*"
        printf "%s Row %d: %s (workspaces %d-%d)\n" "$marker" "$row" "$name" \
            "$(row_col_to_workspace "$row" 1)" "$(row_col_to_workspace "$row" 10)"
    done < "$PROJECTS_FILE"
}

cmd_create() {
    local name=${1:?Usage: hyprcomp create <name>}
    local row
    row=$(next_free_row)

    if [[ $row -ge 10 ]]; then
        echo "Maximum 9 project rows (1-9) reached"
        return 1
    fi

    echo "${row}:${name}" >> "$PROJECTS_FILE"
    log "create: project '$name' at row $row"
    echo "Created project '$name' at row $row (workspaces $(row_col_to_workspace "$row" 1)-$(row_col_to_workspace "$row" 10))"
}

cmd_scratch() {
    local name="${1:-$(next_scratch_name)}"
    local row
    row=$(next_free_row)

    if [[ $row -ge 10 ]]; then
        echo "Maximum 9 project rows (1-9) reached"
        return 1
    fi

    echo "${row}:${name}" >> "$PROJECTS_FILE"

    local ws
    ws=$(row_col_to_workspace "$row" 1)
    echo "current_row=$row" > "$STATE_FILE"
    capture_thumb "$(get_active_workspace)"
    set_animation slidevert
    hyprctl dispatch workspace "$ws" > /dev/null
    hyprctl dispatch exec "[workspace $ws]" alacritty > /dev/null
    pkill -SIGRTMIN+10 waybar 2>/dev/null || true
    log "scratch: created '$name' at row $row"
    echo "Created scratch workspace '$name' at row $row"
}

cmd_rename() {
    local name=${1:?Usage: hyprcomp rename <name>}
    sync_state
    local row
    row=$(get_current_row)

    if ! row_exists "$row"; then
        echo "Current row $row is not a registered project"
        return 1
    fi

    sed -i "s/^${row}:.*/${row}:${name}/" "$PROJECTS_FILE"
    echo "Renamed row $row to '$name'"
}

cmd_delete() {
    sync_state
    local row name
    row=$(get_current_row)
    name=$(get_project_name "$row")

    if ! row_exists "$row"; then
        echo "Current row $row is not a registered project"
        return 1
    fi

    log "delete: project '$name' at row $row"
    clean_row_thumbs "$row"
    sed -i "/^${row}:/d" "$PROJECTS_FILE"
    echo "Deleted project '$name' (row $row)"
    cmd_reorder
}

cmd_delete_row() {
    local row=${1:?Usage: hyprcomp delete-row <row>}
    if [[ $row -eq $DESKTOP_ROW ]]; then
        echo "Cannot delete Desktop row"
        return 1
    fi
    if ! row_exists "$row"; then
        echo "Row $row is not a registered project"
        return 1
    fi
    local name
    name=$(get_project_name "$row")
    clean_row_thumbs "$row"
    sed -i "/^${row}:/d" "$PROJECTS_FILE"
    echo "Deleted project '$name' (row $row)"
    cmd_reorder
}

cmd_reorder() {
    [[ ! -f "$PROJECTS_FILE" ]] || [[ ! -s "$PROJECTS_FILE" ]] && return

    # Read remaining projects sorted by row
    local -a old_rows old_names
    while IFS=: read -r row name; do
        old_rows+=("$row")
        old_names+=("$name")
    done < <(sort -t: -k1 -n "$PROJECTS_FILE")

    # Check if reordering is needed
    local needs=false
    for i in "${!old_rows[@]}"; do
        [[ ${old_rows[$i]} -ne $((i + 1)) ]] && needs=true && break
    done
    $needs || return

    # Snapshot all clients before moving anything
    local clients_json
    clients_json=$(hyprctl clients -j)

    # Track where the current row ends up
    local cur_row
    cur_row=$(get_current_row)
    local new_cur_row=1

    # Build batch command for atomic workspace moves
    local batch=""
    for i in "${!old_rows[@]}"; do
        local old=${old_rows[$i]}
        local new=$((i + 1))

        [[ $old -eq $cur_row ]] && new_cur_row=$new
        [[ $old -eq $new ]] && continue

        for col in $(seq 1 10); do
            local old_ws=$((old * 10 + col))
            local new_ws=$((new * 10 + col))
            while IFS= read -r addr; do
                [[ -n "$addr" ]] && batch+="dispatch movetoworkspacesilent $new_ws,address:$addr;"
            done < <(echo "$clients_json" | jq -r --argjson ws "$old_ws" \
                '.[] | select(.workspace.id == $ws) | .address')
        done
    done
    [[ -n "$batch" ]] && hyprctl --batch "$batch" > /dev/null
    log "reorder: batch moved windows"

    # Rewrite projects file
    > "$PROJECTS_FILE"
    for i in "${!old_rows[@]}"; do
        echo "$((i + 1)):${old_names[$i]}" >> "$PROJECTS_FILE"
    done

    # Update state
    echo "current_row=$new_cur_row" > "$STATE_FILE"
    pkill -SIGRTMIN+10 waybar 2>/dev/null || true
}

cmd_check_deps() {
    local ok=0 fail=0
    check_bin() {
        local name=$1 hint=$2
        if command -v "$name" &>/dev/null; then
            printf "  \033[32m✓\033[0m %s\n" "$name"
            ok=$((ok + 1))
        else
            printf "  \033[31m✗\033[0m %s — %s\n" "$name" "$hint"
            fail=$((fail + 1))
        fi
    }
    echo "Checking dependencies..."
    echo ""
    echo "Required binaries:"
    check_bin hyprctl "Part of Hyprland"
    check_bin jq "Install: pacman -S jq"
    check_bin grim "Install: pacman -S grim"
    check_bin walker "Install: github.com/abenz1267/walker"
    check_bin alacritty "Install: pacman -S alacritty"
    check_bin pkill "Part of procps-ng"
    check_bin python3 "Install: pacman -S python"
    echo ""
    echo "Python imports:"
    if python3 -c "import gi" 2>/dev/null; then
        printf "  \033[32m✓\033[0m gi (PyGObject)\n"
        ok=$((ok + 1))
    else
        printf "  \033[31m✗\033[0m gi — Install: pacman -S python-gobject\n"
        fail=$((fail + 1))
    fi
    if python3 -c "
try:
    import tomllib
except ModuleNotFoundError:
    import tomli
" 2>/dev/null; then
        printf "  \033[32m✓\033[0m tomllib/tomli\n"
        ok=$((ok + 1))
    else
        printf "  \033[31m✗\033[0m tomllib/tomli — Python 3.11+ or: pip install tomli\n"
        fail=$((fail + 1))
    fi
    echo ""
    echo "$ok passed, $fail failed"
    [[ $fail -eq 0 ]]
}

cmd_prune_cache() {
    local dir="$HOME/.cache/hyprcomp/thumbs"
    [[ -d "$dir" ]] || { echo "No cache directory"; return; }
    local clients_json
    clients_json=$(hyprctl clients -j)
    local removed=0
    for thumb in "$dir"/ws-*.jpg; do
        [[ -f "$thumb" ]] || continue
        local fname
        fname=$(basename "$thumb")
        local ws=${fname#ws-}
        ws=${ws%.jpg}
        local count
        count=$(echo "$clients_json" | jq --argjson ws "$ws" \
            '[.[] | select(.workspace.id == $ws)] | length')
        if [[ "$count" -eq 0 ]]; then
            rm -f "$thumb"
            removed=$((removed + 1))
        fi
    done
    echo "Removed $removed stale thumbnails"
}

cmd_overview() {
    # Toggle: signal existing daemon or start new one
    if pkill -USR1 -f 'hyprcomp-overview' 2>/dev/null; then
        exit 0
    fi
    sync_state
    "$(dirname "$0")/hyprcomp-overview" &disown
}

cmd_close() {
    sync_state
    local row
    row=$(get_current_row)
    if [[ $row -eq $DESKTOP_ROW ]]; then
        echo "Cannot close Desktop row"
        return 1
    fi
    if ! row_exists "$row"; then
        echo "Current row $row is not a registered project"
        return 1
    fi
    # Signal running overview daemon (instant) or fall back to standalone
    if pkill -USR2 -f 'hyprcomp-overview' 2>/dev/null; then
        exit 0
    fi
    "$(dirname "$0")/hyprcomp-overview" confirm-close &disown
}

cmd_restart() {
    pkill -f 'hyprcomp-overview' 2>/dev/null || true
    sleep 0.2
    "$(dirname "$0")/hyprcomp-overview" &disown
    echo "Overview daemon restarted"
}

# --- Main ---

# Handle --verbose flag
if [[ "${1:-}" == "--verbose" ]]; then
    VERBOSE=1
    export HYPRCOMP_VERBOSE=1
    shift
fi

cmd=${1:-help}
shift || true

case "$cmd" in
    up)     cmd_up ;;
    down)   cmd_down ;;
    left)   cmd_left ;;
    right)  cmd_right ;;
    go)     cmd_go "$@" ;;
    move)   cmd_move "$@" ;;
    status) cmd_status ;;
    list)   cmd_list ;;
    create)  cmd_create "$@" ;;
    scratch) cmd_scratch "$@" ;;
    rename)  cmd_rename "$@" ;;
    delete)     cmd_delete ;;
    delete-row) cmd_delete_row "$@" ;;
    reorder)    cmd_reorder ;;
    close)       cmd_close ;;
    overview)    cmd_overview ;;
    restart)     cmd_restart ;;
    check-deps)  cmd_check_deps ;;
    prune-cache) cmd_prune_cache ;;
    help)
        echo "Usage: hyprcomp <command> [args]"
        echo ""
        echo "Commands:"
        echo "  up              Switch to same column in previous project row"
        echo "  down            Switch to same column in next project row"
        echo "  left            Move one column left (row-bounded)"
        echo "  right           Move one column right (row-bounded)"
        echo "  go <col>        Switch to column 1-10 of current project row"
        echo "  move <col>      Move active window to column 1-10 of current row"
        echo "  status          Show current project, row, and column"
        echo "  list            List all registered projects"
        echo "  create <name>   Register a new project row"
        echo "  scratch [name]  Create an empty workspace (auto-named if omitted)"
        echo "  rename <name>   Rename current project row"
        echo "  delete          Unregister current project row"
        echo "  delete-row <N>  Unregister project at row N (closes windows)"
        echo "  reorder         Compact row IDs (close gaps from deleted projects)"
        echo "  close           Close current project (with confirmation)"
        echo "  overview        Toggle workspace overview overlay"
        echo "  restart         Restart the overview daemon"
        echo "  check-deps      Verify all runtime dependencies"
        echo "  prune-cache     Remove stale workspace thumbnails"
        echo ""
        echo "Options:"
        echo "  --verbose       Enable debug logging to stderr"
        ;;
    *)
        echo "Unknown command: $cmd"
        echo "Run 'hyprcomp help' for usage"
        exit 1
        ;;
esac

#!/usr/bin/env bash
set -euo pipefail

# Project launcher menu using walker dmenu mode
# Supports subproject navigation via .hyprcomp.toml

PROJECTS_DIR="$HOME/projects"
CONFIG_DIR="$HOME/.config/hyprcomp"
PROJECTS_FILE="$CONFIG_DIR/projects"
CONFIG_TOML="$CONFIG_DIR/config.toml"
OVERVIEW="$(dirname "$0")/hyprcomp-overview"

get_existing() {
    [[ -f "$PROJECTS_FILE" ]] && cut -d: -f2 "$PROJECTS_FILE" || true
}

get_excludes() {
    [[ -f "$CONFIG_TOML" ]] || return
    python3 -c "
try:
    import tomllib
except ModuleNotFoundError:
    import tomli as tomllib
import sys
with open(sys.argv[1], 'rb') as f:
    cfg = tomllib.load(f)
for item in cfg.get('exclude', []):
    print(item)
" "$CONFIG_TOML" 2>/dev/null
}

get_config_val() {
    local key=$1
    [[ -f "$CONFIG_TOML" ]] || return
    python3 -c "
try:
    import tomllib
except ModuleNotFoundError:
    import tomli as tomllib
import sys
with open(sys.argv[1], 'rb') as f:
    cfg = tomllib.load(f)
val = cfg.get(sys.argv[2])
if val is not None:
    print(val)
" "$CONFIG_TOML" "$key" 2>/dev/null
}

is_excluded() {
    local name="$1"
    echo "$EXCLUDES" | grep -qxF "$name"
}

has_subprojects() {
    local toml="$1/.hyprcomp.toml"
    [[ -f "$toml" ]] && grep -q '^\[\[subprojects\]\]' "$toml"
}

get_subprojects() {
    local toml="$1/.hyprcomp.toml"
    [[ -f "$toml" ]] || return
    awk '/^\[\[subprojects\]\]/{found=1; next}
         found && /^path *= *"/{
            gsub(/^path *= *"/, ""); gsub(/".*/, ""); print; found=0
         }
         /^\[/ && !/^\[\[subprojects\]\]/{found=0}' "$toml"
}

# Build menu items for a directory level
# Args: parent_dir prefix show_back
build_menu() {
    local parent_dir="$1" prefix="$2" show_back="$3"
    local existing
    existing=$(get_existing)
    EXCLUDES=$(get_excludes)

    [[ "$show_back" == "1" ]] && echo "‹ Back"

    if [[ "$parent_dir" == "$PROJECTS_DIR" ]]; then
        for dir in "$parent_dir"/*/; do
            [[ -d "$dir" ]] || continue
            local name
            name=$(basename "$dir")
            [[ "$name" == .* ]] && continue
            is_excluded "$name" && continue

            if has_subprojects "$dir"; then
                local all_used=true
                while IFS= read -r sp; do
                    echo "$existing" | grep -qxF "${prefix}${name}/${sp}" || { all_used=false; break; }
                done < <(get_subprojects "$dir")
                [[ "$all_used" == false ]] && echo "${name} ›"
            else
                echo "$existing" | grep -qxF "${prefix}${name}" || echo "$name"
            fi
        done
        echo "+ Scratch"
    else
        while IFS= read -r sp; do
            local sp_dir="$parent_dir/$sp"
            [[ -d "$sp_dir" ]] || continue
            local display
            display=$(basename "$sp")
            is_excluded "$display" && continue
            local full_name="${prefix}${sp}"

            if has_subprojects "$sp_dir"; then
                local all_used=true
                while IFS= read -r nested; do
                    echo "$existing" | grep -qxF "${full_name}/${nested}" || { all_used=false; break; }
                done < <(get_subprojects "$sp_dir")
                [[ "$all_used" == false ]] && echo "${display} ›"
            else
                echo "$existing" | grep -qxF "$full_name" || echo "$display"
            fi
        done < <(get_subprojects "$parent_dir")
    fi
}

# Recursive menu loop
run_menu() {
    local parent_dir="$1" prefix="$2" show_back="$3"

    local items
    items=$(build_menu "$parent_dir" "$prefix" "$show_back")
    [[ -z "$items" ]] && return 1

    local selection
    selection=$(echo "$items" | walker -d -p "Open project…") || return 1
    selection=$(echo "$selection" | tr -d '\n')
    [[ -z "$selection" ]] && return 1

    # Back
    if [[ "$selection" == "‹ Back" ]]; then
        run_menu "$PROJECTS_DIR" "" "0"
        return
    fi

    # Subproject navigation
    if [[ "$selection" == *" ›" ]]; then
        local name="${selection% ›}"
        if [[ "$parent_dir" == "$PROJECTS_DIR" ]]; then
            run_menu "$parent_dir/$name" "${prefix}${name}/" "1"
        else
            local sp_path=""
            while IFS= read -r sp; do
                [[ "$(basename "$sp")" == "$name" ]] && { sp_path="$sp"; break; }
            done < <(get_subprojects "$parent_dir")
            run_menu "$parent_dir/$sp_path" "${prefix}${sp_path}/" "1"
        fi
        return
    fi

    # Leaf selection — resolve full project name
    if [[ "$parent_dir" == "$PROJECTS_DIR" ]]; then
        echo "${prefix}${selection}"
    else
        local sp_path=""
        while IFS= read -r sp; do
            [[ "$(basename "$sp")" == "$selection" ]] && { sp_path="$sp"; break; }
        done < <(get_subprojects "$parent_dir")
        echo "${prefix}${sp_path}"
    fi
}

collect_from_subproject() {
    local parent_dir="$1" sp="$2" prefix="$3"
    local sp_dir="$parent_dir/$sp"
    [[ -d "$sp_dir" ]] || return
    local display
    display=$(basename "$sp")
    is_excluded "$display" && return
    local full_name="${prefix}${sp}"

    if has_subprojects "$sp_dir"; then
        collect_leaves "$sp_dir" "$full_name/"
    else
        echo "$existing" | grep -qxF "$full_name" || echo "$full_name"
    fi
}

collect_leaves() {
    local parent_dir="$1" prefix="$2"

    if [[ "$parent_dir" == "$PROJECTS_DIR" ]]; then
        for dir in "$parent_dir"/*/; do
            [[ -d "$dir" ]] || continue
            local name
            name=$(basename "$dir")
            [[ "$name" == .* ]] && continue
            is_excluded "$name" && continue

            if has_subprojects "$dir"; then
                while IFS= read -r sp; do
                    collect_from_subproject "$dir" "$sp" "${prefix}${name}/"
                done < <(get_subprojects "$dir")
            else
                echo "$existing" | grep -qxF "${prefix}${name}" || echo "${prefix}${name}"
            fi
        done
    else
        while IFS= read -r sp; do
            collect_from_subproject "$parent_dir" "$sp" "$prefix"
        done < <(get_subprojects "$parent_dir")
    fi
}

build_flat_menu() {
    local existing
    existing=$(get_existing)
    EXCLUDES=$(get_excludes)

    collect_leaves "$PROJECTS_DIR" ""
}

run_flat_menu() {
    local items
    items=$(printf '%s\n%s' "+ Scratch" "$(build_flat_menu)")
    [[ -z "$items" ]] && return 1

    local selection
    selection=$(echo "$items" | walker -d -p "Open project…") || return 1
    selection=$(echo "$selection" | tr -d '\n')
    [[ -z "$selection" ]] && return 1
    echo "$selection"
}

main() {
    local name
    if [[ "$(get_config_val flatmap)" == "True" ]]; then
        name=$(run_flat_menu) || exit 0
    else
        name=$(run_menu "$PROJECTS_DIR" "" "0") || exit 0
    fi
    [[ -z "$name" ]] && exit 0

    if [[ "$name" == "+ Scratch" ]]; then
        local scratch_name
        scratch_name=$(echo "" | walker -d -p "Workspace name…") || exit 0
        scratch_name=$(echo "$scratch_name" | tr -d '\n')
        [[ -z "$scratch_name" ]] && exit 0
        "$(dirname "$0")/hyprcomp" scratch "$scratch_name" &disown
        exit 0
    fi

    "$OVERVIEW" launch "$name" &disown
}

main
